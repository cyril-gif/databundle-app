PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/databundle
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=http://localhost:5500

# Paystack (Ghana Mobile Money via the Charge API)
# Get these from Paystack Dashboard > Settings > API Keys & Webhooks
# Use the TEST secret key while developing, LIVE key only once you go live.
PAYSTACK_SECRET_KEY=sk_test_fa0f8c665cff5ee42ec3b6d7d2e0e10e4e668039

# iDataGH (data bundle reseller - actually tops up customer phones)
IDATAGH_API_KEY=your_idatagh_api_key
IDATAGH_BASE_URL=https://idatagh.com/wp-json/custom/v1
# Your profit margin applied on top of iDataGH's cost price when syncing packages
PRICE_MARKUP_PERCENT=8

# Paystack requires an email per charge even though this is a MoMo-only flow.
# We generate one as <phone>@this-domain — use your real domain once you have one.
CUSTOMER_EMAIL_DOMAIN=customer.databundlegh.com

# Admin bootstrap (used only by seed script)
ADMIN_PHONE=0500000000
ADMIN_PIN=1234
